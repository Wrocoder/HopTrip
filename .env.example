APP_ENV=development
APP_NAME=HopTrip API
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://hoptrip:hoptrip@localhost:5432/hoptrip
ADMIN_TOKEN=change-me-in-development
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TRAVELPAYOUTS_API_TOKEN=
TRAVELPAYOUTS_API_BASE_URL=https://api.travelpayouts.com
# Match the aviasales.com destination; this does not change the PLN display currency.
TRAVELPAYOUTS_MARKET=us
FLIGHT_PRICE_REFRESH_GROUPS=40
INGESTION_ORIGINS=WRO,WAW,WMI,KRK,GDN,KTW,POZ
# Approved hosts and SubID are configured per AffiliateProgram through admin API.
PIPELINE_MAX_ATTEMPTS=1
PIPELINE_RETRY_DELAY_SECONDS=5
PIPELINE_INTERVAL_SECONDS=3600

PUBLIC_RATE_LIMIT=120
PROVIDER_MAX_PAGES=5
ANALYTICS_RETENTION_DAYS=90
CORS_ORIGINS=http://localhost:3000

# HT-12: registration remains disabled until SMTP delivery is verified.
# HTR-04 setup and isolated checks: docs/hoptrip-personal-digests.md
ALERTS_ENABLED=false
# HT-13: separate opt-in alerts profile; Europe/Warsaw, Monday=0.
ALERTS_DIGEST_ENABLED=false
ALERTS_DIGEST_HOUR=9
ALERTS_DIGEST_MINUTE=0
ALERTS_DIGEST_WEEKDAY=0
ALERTS_SITE_URL=http://localhost:3000
ALERTS_SIGNING_KEY=
ALERTS_DAILY_SIGNUP_LIMIT=200
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=

# Ticketmaster: keep disabled until the server key and affiliate markets are verified.
EVENTS_ENABLED=false
TICKETMASTER_API_KEY=
TICKETMASTER_AFFILIATE_ID=7853869
EVENTS_COUNTRIES=AT,BE,CH,CY,CZ,DE,DK,ES,FI,FR,GB,GR,IE,IT,NL,NO,PL,SE,TR
EVENTS_SYNC_ENABLED=false
EVENTS_MAX_AGE_HOURS=30
EVENTS_RUN_REQUEST_LIMIT=1000
EVENTS_HORIZON_DAYS=365
EVENTS_DAILY_REQUEST_LIMIT=4000
