# Install only on the server as /etc/hoptrip/monitor.env, root-owned mode 600.
# Fill ONE channel; do not commit credentials or send them in chat.
# Telegram:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# New inbox notifications only (no message contents sent to Telegram):
IMAP_HOST=imap.mail.ovh.net
IMAP_USER=
IMAP_PASSWORD=
# Or SMTP (TLS is mandatory):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_TO=
