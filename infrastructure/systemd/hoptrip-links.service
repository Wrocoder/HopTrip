[Unit]
Description=HopTrip daily editorial source link check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/hoptrip
StateDirectory=hoptrip
UMask=0077
ExecStart=/usr/bin/python3 /opt/hoptrip/scripts/check-activity-links.py
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hoptrip
ProtectHome=true

