HOPTRIP_DOMAIN=deals.example.com
HOPTRIP_EDGE_NETWORK=hoptrip-edge
ACME_EMAIL=ops@example.com
POSTGRES_DB=hoptrip
POSTGRES_USER=hoptrip
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-secret
ADMIN_TOKEN=replace-with-a-long-random-admin-token
TRAVELPAYOUTS_API_TOKEN=
TRAVELPAYOUTS_API_BASE_URL=https://api.travelpayouts.com
# Enable only after the Aviasales program is approved and configured in the database.
TRAVELPAYOUTS_LINKS_ENABLED=false
TRAVELPAYOUTS_MARKER=0
TRAVELPAYOUTS_PROJECT_ID=0
INGESTION_ORIGINS=WRO,WAW,WMI,KRK,GDN,KTW,POZ
# Approved hosts and SubID are configured per AffiliateProgram through admin API.
PIPELINE_MAX_ATTEMPTS=3
PIPELINE_RETRY_DELAY_SECONDS=30
PIPELINE_INTERVAL_SECONDS=3600

PUBLIC_RATE_LIMIT=120
PROVIDER_MAX_PAGES=5
ANALYTICS_RETENTION_DAYS=90

# HT-12: registration remains disabled until SMTP delivery is verified.
# HTR-04: keep disabled until explicit activation; docs/hoptrip-personal-digests.md
ALERTS_ENABLED=false
# HT-13: leave disabled until a separate production launch command.
# Europe/Warsaw; Monday=0. Daily subscriptions use the same hour/minute.
ALERTS_DIGEST_ENABLED=false
ALERTS_DIGEST_HOUR=9
ALERTS_DIGEST_MINUTE=0
ALERTS_DIGEST_WEEKDAY=0
ALERTS_SITE_URL=https://hoptrip.pl
ALERTS_SIGNING_KEY=
ALERTS_DAILY_SIGNUP_LIMIT=200
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
